[Unit]
Description=JNKPU SPS bridge - BLE peripheral <-> HostEC relay (nu-armory)
Documentation=https://github.com/Al1c3-1337/JNKPU
After=bluetooth.service jnkpu.service
Wants=bluetooth.service
# Companion of jnkpu.service: started by its Wants=, stopped/restarted with it.
PartOf=jnkpu.service

[Service]
Type=simple
# Only unblock the radio here (headless Pis often boot Bluetooth soft-blocked).
# Powering the controller and setting its advertised name are done inside the
# bridge over D-Bus: running btmgmt from ExecStartPre -- right as
# bluetooth.service is still bringing the adapter up -- raced bluetoothd and
# hung, whereas the D-Bus calls wait for the adapter properly.
ExecStartPre=-/bin/sh -c 'rfkill unblock bluetooth 2>/dev/null || true'
ExecStart=/usr/bin/python3 /usr/share/jnkpu/sps_bridge.py \
    --relay-host 127.0.0.1 --relay-port 7213 --adapter hci0 --name nurelay

# The bridge is PIN-less and stateless, so unlike jnkpu.service it may restart.
Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal

# No [Install]: this unit is a companion, pulled in by jnkpu.service's Wants=,
# never enabled on its own. (Enabling/booting jnkpu starts it; masking it lets
# jnkpu run as a pure NKPU server without the dongle path.)
