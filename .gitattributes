# Shell scripts and Debian packaging must stay LF - debian/rules and the
# postinst are executed on Linux, and a CRLF shebang line breaks them.
scripts/*       text eol=lf
debian/**       text eol=lf
*.sh            text eol=lf
*.service       text eol=lf

# Windows-side scripts stay CRLF - cmd.exe mis-parses some LF-only batch files.
*.cmd           text eol=crlf
*.inf           text eol=crlf
